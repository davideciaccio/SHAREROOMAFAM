<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.AuthCtrl" prefWidth="400.0" prefHeight="300.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>
    <Label text="Recupera Password"><font><Font name="System Bold" size="20.0" /></font></Label>
    <Label text="Inserisci la tua e-mail per ricevere il codice." />
    <TextField fx:id="emailRecuperoField" promptText="La tua e-mail..." />
    <Button mnemonicParsing="false" onAction="#cliccaOkayRecupero" maxWidth="Infinity" text="Okay" style="-fx-background-color: #0078D7; -fx-text-fill: white;" />
    <Button mnemonicParsing="false" onAction="#mostraAuthView" maxWidth="Infinity" text="Annulla" />
</VBox>