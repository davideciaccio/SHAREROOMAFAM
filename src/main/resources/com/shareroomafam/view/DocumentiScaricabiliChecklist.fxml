<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" fx:controller="com.shareroomafam.control.GestioneStanzeCtrl">
    <VBox alignment="CENTER" spacing="20.0" prefWidth="500.0" prefHeight="400.0" maxWidth="500" maxHeight="400">
        <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>
        <Label text="Permessi di Download"><font><Font name="System Bold" size="24.0" /></font></Label>
        <Label text="Spunta i file che i visitatori potranno scaricare." textFill="#555555"/>
        <ListView fx:id="documentiScaricabiliListView" VBox.vgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#cliccaConfermaCreazione" maxWidth="Infinity" text="Conferma" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-weight: bold;" />
    </VBox>
</StackPane>