<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.ModificaStanzaCtrl" prefWidth="500.0" prefHeight="450.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

    <Label text="Aggiungi Documenti">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    <Label text="Seleziona i nuovi documenti da inserire nella stanza." textFill="#555555" />

    <ListView fx:id="documentiDaInserireListView" VBox.vgrow="ALWAYS" />

    <Button mnemonicParsing="false" onAction="#cliccaAvantiAggiunta" maxWidth="Infinity" text="Avanti" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px;" />

    <Button mnemonicParsing="false" onAction="#mostraModificaStanzaView" maxWidth="Infinity" text="Annulla" style="-fx-padding: 10px;"/>
</VBox>