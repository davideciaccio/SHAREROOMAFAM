<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" fx:controller="com.shareroomafam.control.GestioneDatiPersonaliCtrl">
    <VBox alignment="CENTER" spacing="20.0" prefWidth="400.0" prefHeight="300.0" maxWidth="400" maxHeight="300">
        <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

        <Label text="Modifica Nome d'Arte">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Inserisci il nuovo nome d'arte:" />
            <TextField fx:id="nuovoNomeArteField" promptText="Il tuo nuovo nome d'arte..." />
        </VBox>

        <Button mnemonicParsing="false" onAction="#cliccaConfermaNomeArte" maxWidth="Infinity" text="Conferma" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px;" />

        <Button mnemonicParsing="false" onAction="#mostraGestioneDatiPersonaliView" maxWidth="Infinity" text="Annulla" style="-fx-padding: 10px;"/>
    </VBox>
</StackPane>