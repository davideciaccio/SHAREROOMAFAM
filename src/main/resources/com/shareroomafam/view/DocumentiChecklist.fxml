<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.GestioneStanzeCtrl" prefWidth="500.0" prefHeight="400.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>
    <Label text="Scegli i documenti"><font><Font name="System Bold" size="24.0" /></font></Label>
    <Label text="Spunta i file da inserire nella stanza" textFill="#555555"/>
    <ListView fx:id="documentiChecklistView" VBox.vgrow="ALWAYS" />
    <Button mnemonicParsing="false" onAction="#cliccaAvantiDocumenti" maxWidth="Infinity" text="Avanti" style="-fx-background-color: #0078D7; -fx-text-fill: white;" />
</VBox>