<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" fx:controller="com.shareroomafam.control.GestisciDocumentiCtrl">
    <VBox alignment="CENTER" spacing="20.0" prefWidth="500.0" prefHeight="400.0" maxWidth="500" maxHeight="400">
        <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

        <Label text="Gestisci Documenti">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>
        <Label text="Carica, elimina o modifica la visibilità dei tuoi file" textFill="#555555" />

        <Button mnemonicParsing="false" onAction="#cliccaAggiungiDocumenti" text="Carica documenti" maxWidth="250" style="-fx-padding: 10px; -fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button mnemonicParsing="false" onAction="#cliccaEliminaDocumenti" text="Elimina documenti" maxWidth="250" style="-fx-padding: 10px; -fx-text-fill: red;"/>
        <Button mnemonicParsing="false" onAction="#cliccaCambiaStatoDocumenti" text="Cambia stato documenti" maxWidth="250" style="-fx-padding: 10px;"/>

        <Separator prefWidth="200.0" />
        <Button mnemonicParsing="false" onAction="#tornaAGestioneProfilo" text="Torna Indietro" maxWidth="250" style="-fx-padding: 10px;"/>
    </VBox>
</StackPane>