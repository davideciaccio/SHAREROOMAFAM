<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.GestisciDocumentiCtrl" prefWidth="500.0" prefHeight="450.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

    <Label text="Cambia Stato Documenti">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    <Label text="Spunta per rendere VISIBILE. Togli la spunta per rendere PRIVATO." textFill="#555555" />

    <ListView fx:id="documentiStatoChecklistView" VBox.vgrow="ALWAYS" />

    <Button mnemonicParsing="false" onAction="#cliccaSalvaModifiche" maxWidth="Infinity" text="Salva modifiche" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px;" />

    <Button mnemonicParsing="false" onAction="#mostraGestisciDocumentiView" maxWidth="Infinity" text="Annulla" style="-fx-padding: 10px;"/>
</VBox>