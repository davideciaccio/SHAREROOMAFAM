<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.AuthCtrl" prefWidth="600.0" prefHeight="400.0">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
    </padding>

    <Label text="Homepage Artista">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
    </Label>

    <Button mnemonicParsing="false" onAction="#apriGestioneProfilo" text="Gestione Profilo" maxWidth="200" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" text="Gestione Stanze" maxWidth="200" style="-fx-padding: 10px;"/>
</VBox>