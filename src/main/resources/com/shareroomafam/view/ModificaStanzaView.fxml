<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.ModificaStanzaCtrl" prefWidth="600.0" prefHeight="450.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

    <Label text="Modifica Stanza">
        <font><Font name="System Bold" size="28.0" /></font>
    </Label>

    <Label text="Seleziona l'operazione desiderata per questa stanza" textFill="#555555" />

    <Button mnemonicParsing="false" onAction="#cliccaModificaNomeStanza" text="Modifica nome stanza" maxWidth="300" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" onAction="#cliccaAggiungiDocumenti" text="Aggiungi documenti" maxWidth="300" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" onAction="#cliccaRimuoviDocumenti" text="Rimuovi documenti" maxWidth="300" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" onAction="#cliccaRendiDocumentoScaricabile" text="Rendi documento scaricabile/non scaricabile" maxWidth="300" style="-fx-padding: 10px;"/>

    <Separator prefWidth="200.0" />
    <Button mnemonicParsing="false" onAction="#tornaAGestioneStanze" text="Torna Indietro" maxWidth="300" style="-fx-padding: 10px;"/>
</VBox>