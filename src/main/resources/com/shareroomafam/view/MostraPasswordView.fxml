<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" fx:controller="com.shareroomafam.control.AuthCtrl">
    <VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="300.0" maxWidth="400" maxHeight="300">
        <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>
        <Label text="La tua Password"><font><Font name="System Bold" size="20.0" /></font></Label>
        <VBox alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-padding: 20;">
            <Label fx:id="passwordRecuperataLabel" text="[Password]" textFill="#d32f2f"><font><Font name="System Bold" size="24.0" /></font></Label>
        </VBox>
        <Button mnemonicParsing="false" onAction="#cliccaOkayPassword" maxWidth="Infinity" text="Okay" style="-fx-background-color: #0078D7; -fx-text-fill: white;" />
    </VBox>
</StackPane>