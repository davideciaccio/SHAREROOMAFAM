<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.VisualizzaProfiliCtrl" prefWidth="500.0" prefHeight="650.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

    <Label text="Profilo Artista">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>

    <ImageView fx:id="profiloImmagine" fitHeight="100.0" fitWidth="100.0" preserveRatio="true" />

    <GridPane hgap="10" vgap="15" alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-width: 2; -fx-padding: 20; -fx-background-color: #f9f9f9;">
        <Label text="Nome d'Arte:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="profiloNomeDarteLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <Label fx:id="profiloNomeLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Cognome:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="profiloCognomeLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Sesso:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
        <Label fx:id="profiloSessoLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
        <Label fx:id="profiloEmailLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
        <Label text="Documenti Caricati:" style="-fx-font-weight: bold;" />
        <ListView fx:id="documentiListView" prefHeight="100.0" />
    </VBox>

    <Button mnemonicParsing="false" onAction="#mostraCercaArtistaView" text="Torna alla Ricerca" maxWidth="Infinity" style="-fx-background-color: #6c757d; -fx-text-fill: white;" />
</VBox>