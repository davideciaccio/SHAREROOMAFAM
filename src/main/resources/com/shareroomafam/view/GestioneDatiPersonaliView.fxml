<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.GestioneDatiPersonaliCtrl" prefWidth="600.0" prefHeight="450.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

    <Label text="Gestione Dati Personali">
        <font><Font name="System Bold" size="28.0" /></font>
    </Label>

    <Label text="Cosa desideri modificare?" textFill="#555555" />

    <Button mnemonicParsing="false" onAction="#cliccaModificaImmagine" text="Modifica immagine profilo" maxWidth="250" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" onAction="#cliccaCambiaPassword" text="Cambia password" maxWidth="250" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" onAction="#cliccaModificaNomeArte" text="Modifica nome d'arte" maxWidth="250" style="-fx-padding: 10px;"/>
    <Button mnemonicParsing="false" onAction="#cliccaModificaCarriera" text="Modifica carriera" maxWidth="250" style="-fx-padding: 10px;"/>

    <Separator prefWidth="200.0" />
    <Button mnemonicParsing="false" onAction="#tornaAGestioneProfilo" text="Torna Indietro" maxWidth="250" style="-fx-padding: 10px;"/>
</VBox>