<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shareroomafam.control.GestioneStanzeCtrl" prefWidth="450.0" prefHeight="250.0">
    <padding><Insets bottom="20.0" left="40.0" right="40.0" top="20.0" /></padding>

    <Label text="Condividi Stanza">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    <Label text="Ecco il link univoco della tua stanza:" textFill="#555555" />

    <Label fx:id="linkStanzaLabel" style="-fx-font-weight: bold; -fx-background-color: #e9ecef; -fx-padding: 10px;" />

    <Button mnemonicParsing="false" onAction="#cliccaCopiaLink" maxWidth="Infinity" text="Copia link 📋" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px;" />

    <Button mnemonicParsing="false" onAction="#mostraGestioneStanzeView" maxWidth="Infinity" text="Annulla" style="-fx-padding: 10px;"/>
</VBox>